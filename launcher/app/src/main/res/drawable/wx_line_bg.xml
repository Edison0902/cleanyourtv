<?xml version="1.0" encoding="utf-8"?>
<!-- The weather line: transparent while unfocused, a glass pill when the remote lands on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape><corners android:radius="21dp" /><solid android:color="#3DFFFFFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="21dp" /><solid android:color="#26FFFFFF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="21dp" /><solid android:color="#00000000" /></shape>
    </item>
</selector>
